# Root-level env template (shared/global vars only)
# Service-specific env templates live inside backend/, frontend/, and infra/env/.

# Backend environment template. Copy to .env and fill in real values.
# Never commit .env — it is git-ignored.

# --- Core ---
ENVIRONMENT=local                    # local | staging | production
PORT=8000

# --- Database (Postgres via asyncpg) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kestrel

# --- LLM ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini            # confirm latest suitable model at implementation time
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# --- Breeth memory ---
BREETH_API_KEY=...
BREETH_BASE_URL=https://api.breeth.example

# --- Discovery sources ---
EXA_API_KEY=...
TAVILY_API_KEY=tvly-...              # optional: discovery degrades to Exa+RSS+GitHub
GITHUB_TOKEN=ghp_...                 # optional: higher rate limits on GitHub source
RSS_FEED_URLS=https://example.com/feed.xml,https://another.example/rss

# --- Clerk auth (protects POST /api/agent/init only) ---
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# --- Cadence & editorial thresholds ---
PUBLISH_CYCLE_INTERVAL_MINUTES=120
SELF_AUDIT_EVERY_N_CYCLES=10
EDITORIAL_ACCEPT_THRESHOLD=60.0

# --- Observability (optional) ---
SENTRY_DSN=

#Frontend

# Backend API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Feed Polling Interval (optional, default 15000ms = 15s)
NEXT_PUBLIC_FEED_POLL_INTERVAL_MS=15000
