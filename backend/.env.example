# Backend environment template. Copy to .env and fill in real values.
# Never commit .env — it is git-ignored.

# --- Core ---
ENVIRONMENT=local                    # local | staging | production
PORT=8000

# --- Database (Postgres via asyncpg) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kestrel

# --- LLM ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini            # confirm latest suitable model at implementation time
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Breeth memory ---
BREETH_API_KEY=...
BREETH_BASE_URL=https://api.breeth.example

# --- Discovery sources ---
EXA_API_KEY=...
TAVILY_API_KEY=tvly-...              # optional: discovery degrades to Exa+RSS+GitHub
GITHUB_TOKEN=ghp_...                 # optional: higher rate limits on GitHub source
RSS_FEED_URLS=https://example.com/feed.xml,https://another.example/rss

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=kestrel-agent

# --- Clerk auth (protects POST /api/agent/init only) ---
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# --- Cadence & editorial thresholds ---
PUBLISH_CYCLE_INTERVAL_MINUTES=120
SELF_AUDIT_EVERY_N_CYCLES=10
EDITORIAL_ACCEPT_THRESHOLD=60.0

# --- Observability (optional) ---
SENTRY_DSN=
